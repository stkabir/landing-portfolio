---
import cv from "../../data/cv.json";
import SectionHeading from "../ui/SectionHeading.astro";

const { projects } = cv;
---

<section id="projects" class="py-20 sm:py-32 px-4 relative overflow-hidden">
  <!-- Faint dot pattern -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.035]"
    style="background-image: radial-gradient(var(--color-accentSecondary) 1px, transparent 1px); background-size: 22px 22px;"
  ></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <SectionHeading tag="PROJECTS.DIR" title="Projects" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        projects.map(({ name, description, highlights, url, github, isActive }, index) => (
          <div class="group relative border border-accentSecondary/20 border-t-2 border-t-accentTertiary bg-card/90 p-6 flex flex-col gap-4 cyber-chamfer transition-all duration-200 hover:-translate-y-2 hover:border-accentSecondary/50 hover:neon-glow-tertiary">
            <!-- Active indicator badge -->
            {isActive && (
              <div class="absolute top-4 right-4 flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-accentTertiary animate-pulse shadow-[0_0_6px_var(--color-accentTertiary)]" />
                <span class="font-ui text-[9px] uppercase tracking-widest text-accentTertiary/50">
                  LIVE
                </span>
              </div>
            )}

            <!-- Decorative corner -->
            <div class="absolute bottom-0 right-0 h-5 w-5 border-b-2 border-r-2 border-accentSecondary/20 group-hover:border-accentSecondary/60 transition-colors duration-200" />

            <!-- Project title with different animations based on index -->
            <h3 class={`font-heading font-bold text-lg md:text-xl uppercase tracking-wide text-accentTertiary drop-shadow-[0_0_6px_rgba(0,255,255,0.5)] pr-14 ${
              index % 4 === 0 ? 'cyber-title-glow' :
              index % 4 === 1 ? 'cyber-title-flicker' :
              index % 4 === 2 ? 'cyber-title-pulse' :
              'cyber-title-glitch'
            }`}>
              {name}
            </h3>

            <!-- Description -->
            <p class="font-body text-sm text-foreground/55 leading-relaxed flex-1">
              {description}
            </p>

            <!-- Tech/highlights tags — skewed badges -->
            <div class="flex flex-wrap gap-2">
              {highlights.map((tag) => (
                <span class="-skew-x-6 inline-block border border-accentSecondary/35 bg-accentSecondary/5 px-2.5 py-0.5 font-ui text-[10px] uppercase tracking-widest text-accentSecondary">
                  <span class="inline-block skew-x-6">{tag}</span>
                </span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex items-center gap-3 pt-3 border-t border-border">
              {url && (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-ui text-xs uppercase tracking-widest text-accentTertiary border border-accentTertiary/50 px-3 py-1.5 cyber-chamfer-sm hover:bg-accentTertiary hover:text-background hover:border-accentTertiary hover:shadow-[0_0_15px_var(--color-accentTertiary)] transition-all duration-200"
                >
                  VISIT ↗
                </a>
              )}
              {github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-ui text-xs uppercase tracking-widest text-accentSecondary/50 hover:text-accentSecondary hover:drop-shadow-[0_0_5px_rgba(255,0,255,0.8)] transition-all duration-200"
                >
                  &lt;/CODE&gt;
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

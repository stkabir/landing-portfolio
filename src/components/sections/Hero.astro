---
import cv from "../../data/cv.json";

const { basics } = cv;
const { name, label, location, profiles, email } = basics;
const { city, region } = location;

// Split name for two-line dramatic treatment
const nameParts = name.split(" ");
const firstName = nameParts[0]; // "Miguel"
const lastName = nameParts.slice(1).join(" "); // "Ángel Durán"
---

<section
  class="relative min-h-screen flex flex-col items-center justify-center px-4 py-32 text-center overflow-hidden"
>
  <!-- Subtle dot-grid background layer -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.07]"
    style="background-image: radial-gradient(#FF00FF 1px, transparent 1px); background-size: 28px 28px;"
  ></div>

  <!-- Status badge -->
  <div
    class="relative z-10 inline-flex items-center gap-3 border border-[#FF00FF]/40 bg-[#FF00FF]/5 px-5 py-2 mb-10 font-mono text-[10px] sm:text-xs uppercase tracking-[0.3em] text-[#FF00FF]"
  >
    <span
      class="h-2 w-2 rounded-full bg-[#FF00FF] animate-pulse shadow-[0_0_8px_#FF00FF]"
    ></span>
    SYS:ONLINE — AVAILABLE_FOR_WORK.EXE
  </div>

  <!-- Hero headline: first name (gradient) + last name (chrome) -->
  <h1
    class="relative z-10 font-heading font-black uppercase leading-none mb-8 tracking-tighter"
  >
    <span
      class="block text-[clamp(3rem,12vw,9rem)] bg-gradient-to-r from-[#FF9900] via-[#FF00FF] to-[#00FFFF] bg-clip-text text-transparent drop-shadow-[0_0_50px_rgba(255,0,255,0.45)]"
    >
      {firstName}
    </span>
    <span
      class="block text-[clamp(2.5rem,10vw,7rem)] text-[#E0E0E0] drop-shadow-[0_0_20px_rgba(224,224,224,0.2)]"
    >
      {lastName}
    </span>
  </h1>

  <!-- Terminal-prompt job label -->
  <div
    class="relative z-10 flex items-start justify-center gap-3 mb-10 max-w-2xl mx-auto"
  >
    <span class="text-[#FF00FF] font-mono text-xl sm:text-2xl mt-0.5 shrink-0"
      >&gt;</span
    >
    <p
      class="font-mono text-sm sm:text-base md:text-lg text-[#E0E0E0]/65 text-left leading-relaxed tracking-wide"
    >
      {label}
    </p>
  </div>

  <!-- Location chip -->
  <div
    class="relative z-10 flex items-center gap-2.5 font-mono text-[10px] sm:text-xs uppercase tracking-[0.25em] text-[#E0E0E0]/35 mb-14"
  >
    <span class="text-[#FF9900] text-sm">◈</span>
    <span>{city}, {region}</span>
    <span class="text-[#E0E0E0]/15">|</span>
    <span class="text-[#00FFFF]/50">LAT 41.3°N · LON 2.0°E</span>
  </div>

  <!-- CTA buttons — skewed primary style -->
  <div
    class="relative z-10 flex flex-wrap items-center justify-center gap-4"
  >
    {
      email && (
        <a
          href={`mailto:${email}`}
          class="group relative -skew-x-6 inline-block border-2 border-[#FF00FF] bg-transparent px-7 py-3.5 font-mono text-sm uppercase tracking-widest text-[#FF00FF] transition-all duration-200 ease-linear hover:skew-x-0 hover:bg-[#FF00FF] hover:text-black hover:shadow-[0_0_30px_#FF00FF]"
        >
          <span class="inline-block skew-x-6 group-hover:skew-x-0 transition-transform duration-200">
            CONTACT_ME
          </span>
        </a>
      )
    }
    {
      profiles.map(({ network, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative -skew-x-6 inline-block border-2 border-[#00FFFF]/60 bg-transparent px-7 py-3.5 font-mono text-sm uppercase tracking-widest text-[#00FFFF] transition-all duration-200 ease-linear hover:skew-x-0 hover:bg-[#00FFFF] hover:text-black hover:border-[#00FFFF] hover:shadow-[0_0_30px_#00FFFF]"
        >
          <span class="inline-block skew-x-6 group-hover:skew-x-0 transition-transform duration-200">
            {network}
          </span>
        </a>
      ))
    }
  </div>

  <!-- Scroll hint -->
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 font-mono text-[10px] uppercase tracking-[0.3em] text-[#E0E0E0]/20 z-10"
  >
    <span>SCROLL</span>
    <span class="animate-bounce text-[#FF00FF]/40">▼</span>
  </div>
</section>

---
import cv from "../../data/cv.json";

const { basics } = cv;
const { name, label, location, profiles, email } = basics;
const { city, region } = location;

// Split name for two-line dramatic treatment
const nameParts = name.split(" ");
const firstName = nameParts[0]; // "Miguel"
const lastName = nameParts.slice(1).join(" "); // "Ángel Durán"
---

<section
  class="relative min-h-screen flex flex-col items-center justify-center px-4 py-32 text-center overflow-hidden cyber-noise"
>
  <!-- Circuit grid background layer -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.05] cyber-grid"
  ></div>

  <!-- Floating data streams -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-20 left-10 w-1 h-32 bg-accent opacity-20 animate-pulse"></div>
    <div class="absolute top-40 right-20 w-1 h-24 bg-accentSecondary opacity-20 animate-pulse" style="animation-delay: 0.5s"></div>
    <div class="absolute bottom-32 left-1/4 w-1 h-16 bg-accentTertiary opacity-20 animate-pulse" style="animation-delay: 1s"></div>
  </div>

  <!-- Enhanced status badge with neon border -->
  <div
    class="relative z-10 inline-flex items-center gap-3 border border-accent/40 bg-accent/5 px-5 py-2 mb-10 font-ui text-[10px] sm:text-xs uppercase tracking-[0.3em] text-accent cyber-chamfer neon-glow-sm"
  >
    <span
      class="h-2 w-2 rounded-full bg-accent animate-pulse neon-glow-sm"
    ></span>
    SYS:ONLINE — AVAILABLE_FOR_WORK.EXE
  </div>

  <!-- Hero headline: glitch effect name -->
  <h1
    class="relative z-10 font-heading font-black uppercase leading-none mb-8 tracking-tighter"
  >
    <span
      class="block text-[clamp(3rem,12vw,9rem)] cyber-glitch"
      data-text="{firstName}"
    >
      {firstName}
    </span>
    <span
      class="block text-[clamp(2.5rem,10vw,7rem)] text-foreground drop-shadow-[0_0_20px_rgba(224,224,224,0.2)]"
    >
      {lastName}
    </span>
  </h1>

  <!-- Enhanced terminal-prompt job label -->
  <div
    class="relative z-10 flex items-start justify-center gap-3 mb-12 max-w-2xl mx-auto"
  >
    <span class="text-accent font-body text-xl sm:text-2xl mt-0.5 shrink-0"
      >&gt;</span
    >
    <p
      class="font-body text-sm sm:text-base md:text-lg text-mutedForeground text-left leading-relaxed tracking-wide cyber-cursor"
    >
      {label}
    </p>
  </div>

  <!-- Enhanced location chip with data visualization -->
  <div
    class="relative z-10 flex items-center gap-2.5 font-ui text-[10px] sm:text-xs uppercase tracking-[0.25em] text-mutedForeground mb-14"
  >
    <span class="text-accentSecondary text-sm">◈</span>
    <span>{city}, {region}</span>
    <span class="text-border">|</span>
    <span class="text-accentTertiary/50">LAT 41.3°N · LON 2.0°E</span>
  </div>

  <!-- CTA buttons — cyberpunk style -->
  <div
    class="relative z-10 flex flex-wrap items-center justify-center gap-6"
  >
    {
      email && (
        <a
          href={`mailto:${email}`}
          class="group cyber-focus relative inline-block border-2 border-accent bg-transparent px-7 py-3.5 font-ui text-sm uppercase tracking-widest text-accent transition-all duration-200 ease-linear hover:bg-accent hover:text-background hover:neon-glow cyber-chamfer"
        >
          CONTACT_ME
        </a>
      )
    }
    {
      profiles.map(({ network, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="group cyber-focus relative inline-block border-2 border-accentTertiary/60 bg-transparent px-7 py-3.5 font-ui text-sm uppercase tracking-widest text-accentTertiary transition-all duration-200 ease-linear hover:bg-accentTertiary hover:text-background hover:border-accentTertiary hover:neon-glow-tertiary cyber-chamfer"
        >
          {network}
        </a>
      ))
    }
  </div>

  <!-- Enhanced scroll hint with data stream effect -->
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 font-ui text-[10px] uppercase tracking-[0.3em] text-mutedForeground z-10"
  >
    <span>SCROLL</span>
    <span class="animate-bounce text-accent/40">▼</span>
  </div>
</section>

---
import cv from "../../data/cv.json";
import SectionHeading from "../ui/SectionHeading.astro";

const { basics } = cv;
const { summary, name } = basics;
---

<section id="about" class="py-20 sm:py-32 px-4 relative">
  <div class="max-w-4xl mx-auto">
    <SectionHeading tag="ABOUT.SH" title="About Me" />

    <!-- Enhanced terminal window container -->
    <div
      class="border border-border bg-card cyber-chamfer neon-glow-sm cyber-noise"
    >
      <!-- Window title bar with enhanced styling -->
      <div
        class="flex items-center gap-3 border-b border-border bg-muted px-4 py-3"
      >
        <!-- Enhanced window control dots with neon glow -->
        <div class="flex gap-2">
          <div
            class="h-3 w-3 rounded-full bg-destructive neon-glow-sm animate-pulse"
          ></div>
          <div
            class="h-3 w-3 rounded-full bg-success neon-glow-sm"
          ></div>
          <div
            class="h-3 w-3 rounded-full bg-accentTertiary neon-glow-sm"
          ></div>
        </div>
        <span
          class="font-ui text-xs text-mutedForeground uppercase tracking-widest ml-2 flex-1"
        >
          user@{name.toLowerCase().replace(/\s+/g, "-")}:~/about.sh
        </span>
        <!-- Connection status indicator -->
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-success rounded-full animate-pulse neon-glow-sm"></span>
          <span class="text-success text-xs font-ui">CONNECTED</span>
        </div>
      </div>

      <!-- Enhanced terminal body -->
      <div class="p-6 sm:p-8 font-body space-y-4 relative">
        <!-- Data stream effect in background -->
        <div class="absolute inset-0 pointer-events-none opacity-5">
          <div class="absolute top-4 left-8 w-0.5 h-20 bg-accent animate-pulse"></div>
          <div class="absolute top-12 right-12 w-0.5 h-16 bg-accentSecondary animate-pulse" style="animation-delay: 0.5s"></div>
        </div>

        <!-- Enhanced command line -->
        <div class="flex items-center gap-3 text-accentSecondary/60 text-sm relative z-10">
          <span class="text-accentTertiary/60">$</span>
          <span class="text-mutedForeground font-mono">cat about.txt</span>
          <span class="text-success/50 text-xs ml-auto">[EXECUTING]</span>
        </div>

        <!-- Enhanced output text with data visualization -->
        <p
          class="text-foreground text-sm sm:text-base leading-relaxed pl-4 border-l-2 border-accent/25 relative z-10"
        >
          {summary}
        </p>

        <!-- Enhanced second command line with status -->
        <div class="flex items-center gap-3 text-sm pt-2 relative z-10">
          <span class="text-accentTertiary/60">$</span>
          <span class="text-accentSecondary/40 text-xs tracking-wider font-mono"
            >echo $STATUS</span
          >
        </div>
        <div class="flex items-center gap-3 text-sm pl-4 relative z-10">
          <span class="text-success text-xs tracking-widest font-mono">● AVAILABLE_FOR_WORK:TRUE</span>
          <span class="text-border">|</span>
          <span class="text-accent text-xs tracking-widest font-mono">● COLLABORATIONS:OPEN</span>
        </div>

        <!-- Enhanced system status display -->
        <div class="flex items-center gap-3 text-sm pt-2 relative z-10">
          <span class="text-accentTertiary/60">$</span>
          <span class="text-mutedForeground/50 text-xs font-mono">system_check --status</span>
        </div>
        <div class="grid grid-cols-2 gap-4 pl-4 text-xs font-mono relative z-10">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-success rounded-full animate-pulse"></span>
            <span class="text-success/80">PORTFOLIO_ONLINE</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-accent rounded-full animate-pulse"></span>
            <span class="text-accent/80">RESPONSIVE_MODE</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-accentTertiary rounded-full animate-pulse"></span>
            <span class="text-accentTertiary/80">NEON_RENDERING</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-accentSecondary rounded-full animate-pulse"></span>
            <span class="text-accentSecondary/80">GLITCH_ACTIVE</span>
          </div>
        </div>

        <!-- Enhanced blinking cursor with glow -->
        <div class="flex items-center gap-3 text-sm pt-3 relative z-10">
          <span class="text-accentTertiary/60">$</span>
          <span
            class="inline-block h-4 w-2 bg-accent animate-pulse neon-glow-sm"
          ></span>
          <span class="text-mutedForeground/30 text-xs ml-1">awaiting_command...</span>
        </div>
      </div>
    </div>
  </div>
</section>

---
const navLinks = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
];
---

<header
  class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-4 sm:px-8 py-4 border-b border-border bg-background/90 backdrop-blur-md cyber-chamfer-sm mx-4 mt-4 max-w-7xl lg:mx-auto"
>
  <!-- Logo with enhanced gradient -->
  <a
    href="#"
    class="font-heading font-black text-sm sm:text-base uppercase tracking-widest bg-linear-to-r from-accent via-accentSecondary to-accentTertiary bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(0,240,255,0.5)]"
  >
    &lt;KABIR/&gt;
  </a>

  <!-- Nav links (hidden on small mobile) -->
  <nav class="hidden sm:flex items-center gap-1">
    {
      navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="cyber-focus font-ui text-xs uppercase tracking-widest px-4 py-2 text-mutedForeground hover:text-accent hover:bg-accent/5 transition-all duration-200 border border-transparent hover:border-accent/20 cyber-chamfer-sm"
        >
          {label}
        </a>
      ))
    }
  </nav>

  <!-- Status indicator -->
  <div
    class="flex items-center gap-2 font-ui text-[10px] uppercase tracking-widest text-mutedForeground"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse neon-glow-sm"></span>
    <span class="hidden sm:inline">SYS:ONLINE</span>
  </div>
</header>

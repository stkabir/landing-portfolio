---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Fonts: Orbitron (headings) + JetBrains Mono (body) + Share Tech Mono (UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;600&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- ─── Fixed atmospheric background (z-0) ─────────────────────── -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
      <!-- Enhanced cyberpunk gradient orbs -->
      <div
        class="absolute -top-40 left-1/2 -translate-x-1/2 h-[600px] w-[600px] rounded-full blur-[100px] bg-linear-to-b from-accent to-accentSecondary opacity-[0.08]"
      ></div>
      <!-- Secondary cyan glow, bottom-right -->
      <div
        class="absolute -bottom-48 -right-32 h-[500px] w-[500px] rounded-full blur-[140px] bg-accentTertiary opacity-[0.05]"
      ></div>
      <!-- Tertiary magenta accent, top-left -->
      <div
        class="absolute top-20 -left-20 h-[400px] w-[400px] rounded-full blur-[120px] bg-accentSecondary opacity-[0.04]"
      ></div>
      <!-- Success green accent, bottom-left -->
      <div
        class="absolute bottom-20 -left-32 h-[300px] w-[300px] rounded-full blur-[100px] bg-success opacity-[0.03]"
      ></div>
    </div>

    <!-- ─── Circuit grid floor ─────────────────────────────────── -->
    <div
      class="fixed bottom-0 left-0 right-0 z-0 pointer-events-none cyber-grid"
      style="
        height: 42vh;
        transform: perspective(350px) rotateX(55deg) scaleX(1.6);
        transform-origin: bottom center;
        mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
        -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
      "
    ></div>

    <!-- Enhanced CRT scanlines overlay with noise -->
    <div class="fixed inset-0 z-50 pointer-events-none cyber-scanlines cyber-noise"></div>

    <!-- RGB chromatic aberration with new colors -->
    <div
      class="fixed inset-0 z-50 pointer-events-none opacity-20"
      style="background: linear-gradient(90deg, rgba(255,42,109,0.03), rgba(0,240,255,0.01), rgba(252,238,10,0.03));"
    ></div>

    <!-- ─── Page content ────────────────────────────────────────────── -->
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
